{
  "name": "observatorio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"node --env-file-if-exists=.env --no-warnings=ExperimentalWarning server/index.js\" \"vite\"",
    "dev:all": "concurrently -n server,web,ai -c blue,green,magenta \"node --env-file-if-exists=.env --no-warnings=ExperimentalWarning server/index.js\" \"vite\" \"python pipeline/model_server_template.py\"",
    "ai": "python pipeline/model_server_template.py",
    "ingest": "python pipeline/ingest_open_data.py",
    "titiler": "python pipeline/run_titiler_server.py",
    "web": "vite",
    "server": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node test/alignment.mjs && node test/wind-orientation.mjs && node test/grib2.mjs && node test/grib53.mjs && node test/forecast.mjs && node test/gibs-time.mjs && node test/model-names.mjs && node test/png.mjs && node test/fields.mjs && node test/isobars.mjs && node test/fires.mjs && node test/wind-verify.mjs && node test/assimilate.mjs && node test/dossier.mjs && node --experimental-strip-types test/player.mjs"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "globe.gl": "^2.34.4",
    "lucide-react": "^1.30.0",
    "motion": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  },
  "overrides": {
    "three": "$three"
  }
}
