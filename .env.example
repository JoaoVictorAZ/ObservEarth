# =============================================================================
# CHAVES DE API — copie para `.env` e preencha só o que for usar.
#
# ESTADO ATUAL: nenhuma chave é necessária. Tudo que a plataforma consome hoje
# (NASA GIBS, Open-Meteo, USGS, Natural Earth) é aberto e sem cadastro.
# As entradas abaixo são para os itens do roadmap.
#
# `.env` NÃO deve ir para o Git. Confirme que está no .gitignore.
# =============================================================================

# --- NADA A PREENCHER (sem chave, sem cadastro) ------------------------------
#   NASA GIBS ............. imagens de satélite/reanálise      → em uso
#   Open-Meteo ............ previsão, reanálise, sondagem      → em uso
#   USGS .................. terremotos                          → em uso
#   Natural Earth ......... fronteiras (via jsDelivr)           → em uso
#   NOAA NOMADS ........... GRIB2 do GFS                        → Fase 2
#   NOAA NHC .............. ciclones ativos                     → Fase 2
#   NASA POWER ............ radiação solar, climatologia        → Fase 2
#   DWD ICON opendata ..... modelo alemão                       → Fase 2

# --- NASA FIRMS — focos de incêndio ------------------------------------------
# Chave gratuita por e-mail, emissão imediata:
#   https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Limite: 5.000 transações por intervalo de 10 minutos.
FIRMS_MAP_KEY=

# --- Copernicus CDS — ERA5 (treino do modelo próprio, Fase 3) ----------------
# ATENÇÃO: o CDS antigo foi desligado em setembro de 2024 e o novo CDS é a
# instância oficial desde fevereiro de 2025. Conta antiga NÃO funciona — é
# preciso registrar de novo e aceitar os termos do ERA5.
#   Conta:  https://cds.climate.copernicus.eu/
#   Token:  https://cds.climate.copernicus.eu/how-to-api
# O cliente Python lê de ~/.cdsapirc; estas variáveis são para uso pelo servidor.
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# --- NASA Earthdata Login — produtos DAAC além do GIBS público ---------------
# Cadastro gratuito:  https://urs.earthdata.nasa.gov/users/new
# Token:  Profile > Generate Token  (máx. 2 ativos, com data de expiração)
#
# NÃO é a chave do FIRMS — aquela é o MAP_KEY, de outra página.
# NÃO é necessário para o GIBS: as imagens do globo são WMS público sem auth.
# Serve para download direto de granules/DAAC (CMR, Harmony, earthaccess) na
# Fase 3. Uso: cabeçalho `Authorization: Bearer <token>`.
#
# O token EXPIRA. Quando os downloads começarem a voltar 401, gere outro na
# mesma página — não é bug de código.
EARTHDATA_TOKEN=

# Alternativa a token (algumas bibliotecas antigas ainda pedem usuário e senha):
EARTHDATA_USER=
EARTHDATA_PASS=

# --- Meteostat — séries históricas de estação (opcional) ---------------------
# Só exige chave acima de certo volume:  https://dev.meteostat.net/
METEOSTAT_KEY=

# --- Servidor ----------------------------------------------------------------
PORT=3001
